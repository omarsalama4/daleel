# Live backend is the default. Vite proxies /api to localhost:8000 in development.
VITE_API_BASE_URL=/api/v1
VITE_NEON_AUTH_URL=
# Local setup script writes a random matching token in ignored .env.local.
# Never set VITE_AUTH_MODE=development for hosted builds.
VITE_AUTH_MODE=neon
VITE_DEMO_MODE=false
