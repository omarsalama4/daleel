DALEEL_ENV=development
DALEEL_DATABASE_URL=sqlite:///./data/daleel.db
DALEEL_AUTH_MODE=development
DALEEL_DEV_EMAIL=owner@daleel.local
DALEEL_DEV_TOKEN=replace-with-a-random-local-token
DALEEL_OPERATOR_EMAILS=owner@daleel.local
DALEEL_FRONTEND_URL=http://localhost:5173
DALEEL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DALEEL_WORKER_MODE=inline
# Hosted beta: use jwt auth and a Neon PostgreSQL connection.
# DALEEL_AUTH_MODE=jwt
# DALEEL_JWKS_URL=https://YOUR-NEON-AUTH-DOMAIN/.well-known/jwks.json
# DALEEL_JWT_ISSUER=https://YOUR-NEON-AUTH-DOMAIN
# DALEEL_JWT_AUDIENCE=YOUR-AUDIENCE
# DALEEL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
# DALEEL_WORKER_MODE=cloud_run
# DALEEL_CLOUD_RUN_JOB=projects/PROJECT/locations/REGION/jobs/daleel-worker
DALEEL_GROQ_API_KEY=
DALEEL_GROQ_MODEL=
DALEEL_OPENROUTER_API_KEY=
DALEEL_OPENROUTER_MODEL=
DALEEL_TAVILY_API_KEY=
# Configure conservative route pricing before paid AI routes can be admitted.
DALEEL_AI_INPUT_USD_PER_MILLION=1.0
DALEEL_AI_OUTPUT_USD_PER_MILLION=3.0
DALEEL_BROWSER_ENABLED=false
DALEEL_SESSION_BROKER_URL=
DALEEL_SESSION_BROKER_TOKEN=
# Generate with Fernet.generate_key(); required for authenticated session storage.
DALEEL_SESSION_ENCRYPTION_KEY=
DALEEL_STORAGE_MODE=local
DALEEL_STORAGE_ROOT=./data/artifacts
# S3 compatible Neon Object Storage settings; credentials belong in secrets.
DALEEL_S3_ENDPOINT=
DALEEL_S3_BUCKET=
DALEEL_S3_ACCESS_KEY=
DALEEL_S3_SECRET_KEY=
DALEEL_OTLP_ENDPOINT=
DALEEL_LANGFUSE_PUBLIC_KEY=
DALEEL_LANGFUSE_SECRET_KEY=
DALEEL_LANGFUSE_ENDPOINT=https://cloud.langfuse.com
DALEEL_RESEND_API_KEY=
DALEEL_EMAIL_FROM=

# Optional separate human-operated browser broker
DALEEL_BROKER_PUBLIC_URL=http://127.0.0.1:8001
DALEEL_BROKER_SITES={}
DALEEL_BROKER_MAX_CONNECTIONS=2
